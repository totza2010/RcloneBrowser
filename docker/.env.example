# Copy to docker/.env and edit. compose refuses to start without VNC_PASSWORD.

# The desktop session is unencrypted; this is the only thing between it and
# anyone who can reach the port.
VNC_PASSWORD=1234

# Where rclone.conf, saved tasks and per-job logs live. Leave unset to use a
# Docker-managed volume, which works the same on Windows and Linux. Set it to
# a directory to keep the data on the host instead -- for example to carry on
# using an rclone.conf you already have:
#
#   RB_CONFIG=/home/you/.config/rclone
#   RB_CONFIG=C:\Users\you\AppData\Roaming\rclone
#RB_CONFIG=

# What the container can see to transfer. Unset means an empty managed volume.
#   RB_MEDIA=/mnt
#   RB_MEDIA=D:\Media
#RB_MEDIA=

# An rclone.conf kept elsewhere: uncomment the /rclone-config mount and the
# RCLONE_CONFIG line in compose.yaml. Mount the directory, not the file --
# see the comment there for why.

# Use an rclone from the host instead of the one in the image. Uncomment the
# matching line in compose.yaml as well. It must be a Linux binary for the
# container's architecture: a Windows rclone.exe cannot run inside a Linux
# container, so on Windows this means pointing at a Linux build.
#RB_RCLONE=/usr/local/bin/rclone

# Owner of the files written into a host directory. Ignored when using the
# managed volumes above.
#USER_ID=1000
#GROUP_ID=1000

# Host port for the web interface. Windows reserves scattered ranges for
# Hyper-V and refuses to bind inside them; the error talks about socket
# access permissions rather than the port being reserved. Check with:
#   netsh interface ipv4 show excludedportrange protocol=tcp
#RB_PORT=5800

#TZ=Asia/Bangkok

